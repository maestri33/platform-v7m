# Variáveis de ambiente — app-supletivo (cliente final).
#
# Cópia este arquivo para `.env.local` (gitignored) e preenche com os
# valores do teu ambiente. O `.env.example` é versionado e serve de
# documentação; o `.env.local` NUNCA é commitado.

# ─── Backend (Django+Ninja) ────────────────────────────────────────────────
#
# URL_BACKEND é server-side only — o browser nunca vê esse valor.
# Aponta para o Django em runtime. Em dev local costuma ser o IP da LXC
# (ex.: http://10.1.20.30) ou um tunnel; em prod é o domínio público
# (ex.: https://backend.v7m.live).
URL_BACKEND=http://10.1.20.30

# NEXT_PUBLIC_API_BASE_URL é exposto ao bundle do browser (NEXT_PUBLIC_*).
# Vazio = same-origin: o browser chama /api/* no próprio Next, que reescreve
# para URL_BACKEND no servidor (killing CORS e mixed-content).
# Em setups exóticos (CDN na frente, multi-domínio) preenche com a URL
# absoluta do Next público. Na dúvida, deixa vazio.
NEXT_PUBLIC_API_BASE_URL=

# ─── Build provenance (inlined em /healthz) ────────────────────────────────
#
# Estes dois são exportados pelo deploy.yml antes do `npm run build`
# (ver .github/workflows/deploy.yml). Para dev local pode deixar em
# branco — o default é "unknown".
GIT_SHA=
BUILD_AT=