# Django core
SECRET_KEY=<change-me>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
APP_BASE_URL=http://localhost:8000
URL_FROTEND=http://localhost:3000

# Database
# Preferred setup:
# - local dev: DATABASE_ENGINE=sqlite
# - shared/dev/prod: DATABASE_ENGINE=postgresql or DATABASE_URL=postgresql://...
DATABASE_ENGINE=sqlite
DATABASE_URL=
SQLITE_NAME=db.sqlite3
SQLITE_TIMEOUT_SECONDS=20
DATABASE_CONN_MAX_AGE=60

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_SSLMODE=

# Optional administrative credentials for local scripts/maintenance
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<postgres-superuser-password>

# Tests
# false: default tests use sqlite in-memory
# true: tests use the primary Postgres configuration and create test_<db_name>
TEST_DATABASE_USE_PRIMARY=false
TEST_DATABASE_ENGINE=
TEST_DATABASE_URL=
TEST_DATABASE_NAME=
TEST_DATABASE_CHARSET=UTF8
TEST_DATABASE_TEMPLATE=template0

# Email / SMTP
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=webmaster@localhost

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=default
EVOLUTION_API_KEY=
EVOLUTION_REQUEST_TIMEOUT=30

# ElevenLabs API
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REQUEST_TIMEOUT=30
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_CONTEXT_PROFILE=
ELEVENLABS_V3_PREFIX_TAGS=
ELEVENLABS_VOICE_STABILITY=
ELEVENLABS_VOICE_SIMILARITY_BOOST=
ELEVENLABS_VOICE_STYLE=
ELEVENLABS_VOICE_SPEED=
ELEVENLABS_VOICE_USE_SPEAKER_BOOST=

# MiniMax API (visao = provider padrao desde 2026-06-23; TTS ja era MiniMax)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_VISION_TIMEOUT=60
MINIMAX_VOICE_MALE=
MINIMAX_VOICE_FEMALE=

# LGPD — DESLIGADO por padrao. So ligar com autorizacao EXPLICITA do dono.
# Enquanto False: NADA de consent_*, legal_basis_*, retention_*, /api/lgpd/*.
# Ver feedback-lgpd-off-by-default na memoria.
LGPD_ENABLED=false

# Gemini API
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REQUEST_TIMEOUT=45
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-2.5-flash-image,gemini-3-pro-image-preview

# Auth / OTP
AUTH_LOGIN_OTP_TTL_SECONDS=600
AUTH_LOGIN_OTP_COOLDOWN_SECONDS=60
AUTH_LOGIN_OTP_MAX_SENDS_PER_WINDOW=5
AUTH_LOGIN_OTP_WINDOW_SECONDS=900

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.ieadpg.org,https://api-ieadpg.m33.live
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.ieadpg.org,https://api-ieadpg.m33.live

# Taskiq / Redis
TASKIQ_REDIS_URL=redis://localhost:6379/0
TASKIQ_QUEUE_NAME=taskiq
TASKIQ_BROKER_NAME=ieadpg_worker
TASKIQ_ENABLED=True
TASKIQ_EAGER=False

# Taskiq Dashboard
TASKIQ_DASHBOARD_HOST=0.0.0.0
TASKIQ_DASHBOARD_PORT=9000
TASKIQ_DASHBOARD_TOKEN=supersecret
TASKIQ_DASHBOARD_ROOT_PATH=
TASKIQ_DASHBOARD_STORAGE=sqlite
TASKIQ_DASHBOARD_URL=http://localhost:9000
TASKIQ_DASHBOARD_DATABASE_DSN=

# Optional dashboard DSN overrides
TASKIQ_DASHBOARD_POSTGRES__DSN=
TASKIQ_DASHBOARD_SQLITE__DSN=
TASKIQ_DASHBOARD_SQLITE__FILE_PATH=

# IA multi-provider (integrations/ai) — FONTE UNICA: 1 chain por capability
# Cada chain é CSV ``provider:model,provider:model,...`` (1º = primário).
# App só chama ``integrations.ai.{text,vision,image,tts}`` — pra trocar
# provedor é mudar o .env, sem editar código.
#
# Decisão 2026-06-24:
# - Texto: OmniRouter (combo default -> fallback) — provider unico do LLM (2026-07-19)
# - Visao: MiniMax primario, Gemini fallback
# - Imagem: MiniMax primario, Gemini fallback
# - TTS:   ElevenLabs primario, MiniMax fallback
IA_TEXT_CHAIN=omnirouter:default,omnirouter:fallback
IA_VISION_CHAIN=minimax:MiniMax-M3,gemini:gemini-2.5-flash
IA_IMAGE_CHAIN=minimax:MiniMax-M3,gemini:gemini-2.5-flash-image
IA_TTS_CHAIN=elevenlabs:eleven_v3,minimax:speech-2.8-hd
# Alias retrocompativel — chamadas antigas ainda funcionam (leem IA_TEXT_CHAIN).
IA_FALLBACK_CHAIN=omnirouter:default,omnirouter:fallback

# Flags por provider (false = desabilita, mesmo com credencial)
# Provider unico do cerebro de texto (2026-07-19): OmniRouter, gateway
# OpenAI-compatible na VPN. Faz o fan-out/fallback interno. ``default`` e
# ``fallback`` sao combos configurados no proprio OmniRouter.
IA_ENABLED_OMNIROUTER=true
IA_OMNIROUTER_BASE_URL=http://10.1.30.35/v1
IA_OMNIROUTER_API_KEY=<sua-chave-omnirouter>
# --- legado (desabilitado; _KNOWN_PROVIDERS so reconhece omnirouter agora) ---
IA_ENABLED_GROQ=false
IA_GROQ_BASE_URL=https://api.groq.com/openai/v1
IA_GROQ_API_KEY=
IA_ENABLED_DEEPSEEK=false
IA_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
IA_DEEPSEEK_API_KEY=
IA_ENABLED_MINIMAX=false
IA_MINIMAX_BASE_URL=https://api.minimax.chat/v1
IA_MINIMAX_API_KEY=
IA_MINIMAX_TTS_MODEL=speech-2.8-hd
IA_MINIMAX_VOICE_MALE=minimax_male_voice
IA_MINIMAX_VOICE_FEMALE=minimax_female_voice
IA_MINIMAX_VISION_MODEL=MiniMax-M3
IA_ENABLED_OPENAI=false
IA_OPENAI_BASE_URL=https://api.openai.com/v1
IA_OPENAI_API_KEY=

# ElevenLabs (TTS primario — fora do registry IA_* pq já tem namespace próprio)
ELEVENLABS_API_KEY=<your-elevenlabs-key>
GOOGLE_VISION_API_KEY=
EVOLUTION_BR_JID_CACHE_TTL_S=3600

# Asaas (PIX/boleto) — M3.1
# sk-dev-dummy ativa modo mock no client (sem chamada real).
ASAAS_API_KEY=sk-dev-dummy
# ``ASAAS_WEBHOOK_TOKEN`` é o nome canonico (M3.2). ``ASAAS_WEBHOOK_SECRET``
# continua aceito como alias retrocompativel (mesmo valor).
ASAAS_WEBHOOK_TOKEN=<your-asaas-webhook-token>
ASAAS_WEBHOOK_SECRET=<your-asaas-webhook-secret>
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_REQUEST_TIMEOUT=10

# InfinitePay (cartão) — M3.1
# handle "dev" ativa modo mock no client.
INFINITEPAY_HANDLE=dev
INFINITEPAY_BASE_URL=https://api.infinitepay.io
INFINITEPAY_HTTP_TIMEOUT=10

# CPFHub (consulta CPF) — M1.8
# Api-key obrigatoria para o lookup funcionar (system check ``cpf.W001``
# emite Warning se faltar). Retry 429/5xx em integrations.tools.cpf.
CPFHUB_API_URL=https://api.cpfhub.io/cpf
CPFHUB_API_KEY=
CPFHUB_REQUEST_TIMEOUT=10

# Captive Portal Wi-Fi (apps.captive) — design "Fluxo Captive Portal IEADPG"
# O agente local (local_agent/agent.py, na rede da igreja) chama
# POST /portal/session/start com o MAC; depois do OTP o backend devolve a
# liberacao com uma credencial HMAC que identifica o MAC (push assinado no
# CAPTIVE_LOCAL_CALLBACK_URL ou polling em GET /portal/agent/grants).
CAPTIVE_AGENT_KEY=<chave-do-agente-local>
CAPTIVE_AGENT_SECRET=<segredo-hmac-compartilhado>
# Vazio = agente opera só por polling (funciona atras de NAT).
CAPTIVE_LOCAL_CALLBACK_URL=
CAPTIVE_CALLBACK_TIMEOUT=4
CAPTIVE_CALLBACK_RETRIES=3
CAPTIVE_GRANT_TTL_SECONDS=43200
CAPTIVE_OTP_MAX_ATTEMPTS=3
CAPTIVE_OTP_LOCK_MINUTES=10
# Base publica usada na portal_url devolvida ao agente (ex: https://backend.ieadpg.org).
CAPTIVE_PORTAL_BASE_URL=
CAPTIVE_APP_URL=https://app.ieadpg.org
# Agenda fallback de cultos (Fase D): "dia hh:mm-hh:mm" separados por ";".
CAPTIVE_WORSHIP_SCHEDULE=dom 09:00-11:30;dom 18:30-21:30;qua 19:30-21:30
CAPTIVE_WORSHIP_TOLERANCE_MIN=30
CAPTIVE_POST_WORSHIP_DELAY_MIN=15
