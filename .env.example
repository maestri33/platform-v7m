# Django core
SECRET_KEY=<change-me>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
APP_BASE_URL=http://localhost:8000
URL_FROTEND=http://localhost:3000

# Database
# Preferred setup:
# - local dev: DATABASE_ENGINE=sqlite
# - shared/dev/prod: DATABASE_ENGINE=postgresql or DATABASE_URL=postgresql://...
DATABASE_ENGINE=sqlite
DATABASE_URL=
SQLITE_NAME=db.sqlite3
SQLITE_TIMEOUT_SECONDS=20
DATABASE_CONN_MAX_AGE=60

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_SSLMODE=

# Optional administrative credentials for local scripts/maintenance
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<postgres-superuser-password>

# Tests
# false: default tests use sqlite in-memory
# true: tests use the primary Postgres configuration and create test_<db_name>
TEST_DATABASE_USE_PRIMARY=false
TEST_DATABASE_ENGINE=
TEST_DATABASE_URL=
TEST_DATABASE_NAME=
TEST_DATABASE_CHARSET=UTF8
TEST_DATABASE_TEMPLATE=template0

# Email / SMTP
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=webmaster@localhost

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=default
EVOLUTION_API_KEY=
EVOLUTION_REQUEST_TIMEOUT=30

# ElevenLabs API
ELEVENLABS_API_KEY=
ELEVENLABS_REQUEST_TIMEOUT=30
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_CONTEXT_PROFILE=
ELEVENLABS_V3_PREFIX_TAGS=
ELEVENLABS_VOICE_STABILITY=
ELEVENLABS_VOICE_SIMILARITY_BOOST=
ELEVENLABS_VOICE_STYLE=
ELEVENLABS_VOICE_SPEED=
ELEVENLABS_VOICE_USE_SPEAKER_BOOST=

# Groq API
GROQ_API_KEY=
GROQ_REQUEST_TIMEOUT=30
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini API
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REQUEST_TIMEOUT=45
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-2.5-flash-image,gemini-3-pro-image-preview

# Auth / OTP
AUTH_LOGIN_OTP_TTL_SECONDS=600
AUTH_LOGIN_OTP_COOLDOWN_SECONDS=60
AUTH_LOGIN_OTP_MAX_SENDS_PER_WINDOW=5
AUTH_LOGIN_OTP_WINDOW_SECONDS=900

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.ieadpg.org,https://api-ieadpg.m33.live
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.ieadpg.org,https://api-ieadpg.m33.live

# Taskiq / Redis
TASKIQ_REDIS_URL=redis://localhost:6379/0
TASKIQ_QUEUE_NAME=taskiq
TASKIQ_BROKER_NAME=ieadpg_worker
TASKIQ_ENABLED=True
TASKIQ_EAGER=False

# Taskiq Dashboard
TASKIQ_DASHBOARD_HOST=0.0.0.0
TASKIQ_DASHBOARD_PORT=9000
TASKIQ_DASHBOARD_TOKEN=supersecret
TASKIQ_DASHBOARD_ROOT_PATH=
TASKIQ_DASHBOARD_STORAGE=sqlite
TASKIQ_DASHBOARD_URL=http://localhost:9000
TASKIQ_DASHBOARD_DATABASE_DSN=

# Optional dashboard DSN overrides
TASKIQ_DASHBOARD_POSTGRES__DSN=
TASKIQ_DASHBOARD_SQLITE__DSN=
TASKIQ_DASHBOARD_SQLITE__FILE_PATH=
