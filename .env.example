DATABASE_URL=postgres://notify:notify@localhost:5432/notify_server
SECRET_KEY=change-me-to-a-random-string
DEBUG=1
ALLOWED_HOSTS=*
EXTERNAL_URL=http://10.1.30.114
# Base que o Evolution usa para BUSCAR a mídia. Desde a migração da Evolution GO
# para a mesma LXC do v2 (10.1.20.200), notify e Evolution estão na MESMA rede
# 10.1.x — não há mais relay Tailscale no meio.
MEDIA_LAN_BASE=http://10.1.30.114
MEDIA_ROOT=/opt/notify-server/media
MEDIA_URL=/media/

OMNIROUTER_URL=http://10.1.30.35
OMNIROUTER_API_KEY=
# Assistente de texto (templates de e-mail e reescrita). IA é assistiva: se o
# gateway estiver fora, o envio continua — só a sugestão não aparece.
AI_MODEL=auto/fast
AI_TIMEOUT_S=90

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Default para chamadas SEM row WhatsAppNumber (legado). Com row, quem decide o
# provedor é o campo `driver` dela — e `fallback_driver` diz para onde cair.
WHATSAPP_DRIVER=evolution-v2
# Trava de emergência: força este provedor em TODAS as contas, ignorando as rows.
# Use só durante incidente de provedor e esvazie depois.
WHATSAPP_FORCE_DRIVER=

# Evolution v2 (base)
WHATSAPP_API_BASE_URL=http://10.1.20.200
WHATSAPP_GLOBAL_API_KEY=

# Evolution GO (fallback + funções extras) — mesma LXC do v2
EVOLUTION_GO_BASE_URL=http://10.1.20.200:4000
# Token da instância DEFAULT (envio). Cada WhatsAppNumber guarda o seu no DB.
EVOLUTION_GO_API_KEY=
# Key GLOBAL da GO — só administração (listar/criar instância). NÃO serve para
# enviar: com várias instâncias, a key global resolve para uma arbitrária.
EVOLUTION_GO_ADMIN_KEY=

# ── Mailcow (API administrativa) ───────────────────────────────────────────
MAILCOW_BASE_URL=https://mail.v7m.org
MAILCOW_API_KEY=
MAILCOW_VERIFY_TLS=0
MAILCOW_DEFAULT_QUOTA_MB=1024
MAILCOW_SMTP_HOST=mail.v7m.org
MAILCOW_SMTP_PORT=587

TEST_MODE=0
FERNET_KEY=change-me-generate-with-python-cryptography
