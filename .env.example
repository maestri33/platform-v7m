# Tudo abaixo é opcional no ambiente local; o Compose possui defaults.
POSTGRES_PASSWORD=notify-local-password
NOTIFY_HOST_PORT=8000
EVOLUTION_V2_HOST_PORT=18080
EVOLUTION_GO_HOST_PORT=4000
DATABASE_URL=postgres://notify:notify-local-password@localhost:5432/notify
SECRET_KEY=change-me-to-a-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
EXTERNAL_URL=http://127.0.0.1:8000
MEDIA_LAN_BASE=http://notify-web:8000
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
OMNIROUTER_URL=
OMNIROUTER_API_KEY=
WHATSAPP_API_BASE_URL=http://evolution-v2:8080
WHATSAPP_GLOBAL_API_KEY=notify-local-v2-key
EVOLUTION_GO_BASE_URL=http://evolution-go:4000
EVOLUTION_GO_API_KEY=notify-local-go-key
# Opcional. Deixe vazio: o ambiente local nao ativa nem conecta instancias.
EVOLUTION_OPERATOR_EMAIL=
# O Compose local forca dry-run e ignora 0 para impedir envios acidentais.
TEST_MODE=1
FERNET_KEY=change-me-generate-with-python-cryptography
# Sentry — DSN vazio desliga o SDK por completo
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Destinatário (telefone/e-mail) é PII — só ligue os dois conscientemente
SENTRY_SEND_DEFAULT_PII=0
SENTRY_INCLUDE_LOCAL_VARIABLES=0
