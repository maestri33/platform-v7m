# ─── V7M ECOSYSTEM CONFIGURAÇÃO CENTRAL (.env) ────────────────────────────────
# Copie este arquivo para .env na raiz antes de rodar o docker-compose ou os scripts.

# ── 1. CONTA-MÃE (VICTOR / BOSS / SUPERUSER / DEFAULT HUB) ────────────────────
# Preencha com seus dados reais para receber OTP no WhatsApp e receber comissões no Pix
DEFAULT_STAFF_NAME=Victor Maestri
DEFAULT_STAFF_CPF=11144477735
DEFAULT_STAFF_PHONE=5511999990000
DEFAULT_STAFF_EMAIL=victor@v7m.org
DEFAULT_STAFF_PASSWORD=sua-senha-segura-aqui
DEFAULT_STAFF_PIX=sua-chave-pix-real@aqui
DEFAULT_HUB_BRAND=standard

# ── 2. INTEGRAÇÕES BANCÁRIAS (ASAAS PIX / CARTÃO) ─────────────────────────────
# Obtenha sua API Key em https://sandbox.asaas.com (dev) ou https://www.asaas.com (prod)
ASAAS_API_KEY=$aact_YTU5YTE0M2M6...
ASAAS_WEBHOOK_SECRET=segredo-webhook-asaas
INFINITEPAY_HANDLE=v7m_pagamentos

# ── 3. MENSAGERIA & WHATSAPP (EVOLUTION GO / NOTIFY) ─────────────────────────
EVOLUTION_GO_API_KEY=notify-local-go-key
NOTIFY_API_KEY=notify-local-secret-key
CPFHUB_API_KEY=cpfhub-secret-key

# ── 4. IA PROVIDERS (KYC / DOCUMENTOS / ESCOLARIDADE) ────────────────────────
IA_PROVIDERS=gemini,minimax,fake
IA_GEMINI_API_KEY=
MINIMAX_API_KEY=
OMNIROUTE_API_KEY=

# ── 5. PORTAS LOCAIS (DOCKER / SERVIÇOS) ─────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_PASSWORD=v7m-local-password
REDIS_PORT=6380
BACKEND_PORT=8001
ADMIN_PORT=3003
APP_V7M_PORT=3001
APP_SUPLETIVO_PORT=3020
NOTIFY_PORT=8000
EVOLUTION_GO_PORT=4000

# ── 6. CLOUDFLARE TUNNEL (OPCIONAL) ──────────────────────────────────────────
# Para túnel permanente com domínio próprio:
CLOUDFLARE_TUNNEL_TOKEN=
