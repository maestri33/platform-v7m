[Unit]
Description=Notify Server - Django-Q Cluster
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/notify-server
Environment="PATH=/opt/notify-server/.venv/bin"
EnvironmentFile=/opt/notify-server/.env
ExecStart=/opt/notify-server/.venv/bin/python manage.py qcluster
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
