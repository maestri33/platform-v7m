# Notify Server — HTTP interno na porta 80 (LAN/VPN)
# TLS público, quando necessário, termina em um proxy externo.

:80 {
	bind 10.1.30.114

	handle / {
		root * /opt/notify-server/deploy/site
		rewrite * /SKILL.md
		header Content-Type "text/markdown; charset=utf-8"
		file_server
	}

	handle_path /media/* {
		root * /opt/notify-server/media
		file_server
	}

	reverse_proxy 127.0.0.1:8100
}
