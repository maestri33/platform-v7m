[Unit]
Description=app-promotor (Next.js standalone — front do colaborador V7M)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/app-promotor/.next/standalone
# BACKEND_URL = Django+Ninja de produção; PORT atrás do reverse proxy (Caddy CT200).
Environment=NODE_ENV=production
Environment=BACKEND_URL=https://backend.v7m.live
Environment=PORT=3001
Environment=HOSTNAME=0.0.0.0
# IA da escolaridade (OmniRoute). Enquanto estas linhas não existirem NO LXC
# (este arquivo é referência; o runtime lê /etc/systemd/system/), a etapa abre
# no formulário manual em vez de num chat que não responde.
# Environment=OMNIROUTE_BASE_URL=https://omniroute.exemplo
# Environment=OMNIROUTE_API_KEY=trocar
# Environment=OMNIROUTE_EDUCATION_MODEL=groq/llama-3.3-70b-versatile
ExecStart=/usr/bin/node /opt/app-promotor/.next/standalone/server.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
