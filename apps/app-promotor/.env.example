# Contrato de env do front (server-side, NÃO exposto ao client).
#
# Único valor que muda entre ambientes: o endereço do backend Django+Ninja.
# Em dev o Django roda na porta 80 do host; em prod é o domínio público.

# DEV (Django local na 80 deste host)
# BACKEND_URL=http://localhost:80

# PROD
BACKEND_URL=https://backend.v7m.live
APP_ENV=prod

# Config pública compartilhada com maestri.group (embutida no build)
NEXT_PUBLIC_LEGAL_BASE_URL=https://maestri.group
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511920062177

# IA da etapa de escolaridade (OmniRoute). SEM estas duas, a etapa abre direto
# no formulário manual — o chat só aparece quando o servidor está configurado.
# Precisam existir no systemd do LXC (/etc/systemd/system/app-promotor.service),
# não só aqui: este arquivo é referência, o runtime é quem lê.
# OMNIROUTE_BASE_URL=https://omniroute.exemplo
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto/best-vision
# OMNIROUTE_EDUCATION_MODEL=groq/llama-3.3-70b-versatile

# NODE_ENV=production é setado pelo runtime (`node server.js`); com BACKEND_URL
# https, os cookies de sessão saem com `Secure` (lib/auth/cookies.ts).
