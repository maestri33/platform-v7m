---
/**
 * Layout base: SEO head completo, fontes, JSON-LD e scripts globais.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { APP_URL, BRAND, GTM_ID } from '../config';

const appOrigin = new URL(APP_URL).origin;

interface Props {
  title: string;
  description: string;
  /** JSON-LD (objeto único ou @graph) — opcional */
  schema?: Record<string, unknown>;
  /** páginas fora do índice (ex.: legais até o CNPJ real) */
  noindex?: boolean;
  /** OG própria da página (path em /public); default: og-image.png */
  ogImage?: string;
}

const {
  title,
  description,
  schema,
  noindex = false,
  ogImage: ogImagePath = '/og-image.png',
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(ogImagePath, site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#002776" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- destino dos CTAs: handshake antecipado = app abre mais rápido no clique -->
    <link rel="preconnect" href={appOrigin} crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Supletivo Brasil — Você parou. Mas não acabou." />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <!-- Fontes críticas (display do hero + corpo) -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Estado "tem JS": animações de reveal só escondem conteúdo sob html.js -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {GTM_ID && (
      <script is:inline define:vars={{ GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',GTM_ID);
      </script>
    )}
  </head>
  <body>
    {GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <!-- WebMCP: Expose structured tools to AI agents via navigator.modelContext -->
    <script is:inline type="module">
      (function() {
        if (typeof window === 'undefined' || typeof navigator === 'undefined') return;
        if (!('modelContext' in navigator) || !navigator.modelContext || typeof navigator.modelContext.registerTool !== 'function') return;
        if (window.__webmcp_initialized) return;
        window.__webmcp_initialized = true;

        const controller = new AbortController();
        const signal = controller.signal;

        const tools = [
          {
            name: 'check_eligibility',
            description: 'Verifica a elegibilidade do aluno para conclusão do Ensino Fundamental (mínimo 15 anos) ou Ensino Médio (mínimo 18 anos) no Supletivo Brasil.',
            inputSchema: {
              type: 'object',
              properties: {
                age: { type: 'integer', minimum: 10, maximum: 120, description: 'Idade do candidato em anos' },
                level: { type: 'string', enum: ['fundamental', 'medio'], default: 'medio', description: 'Nível de escolaridade desejado' }
              },
              required: ['age']
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => {
              const age = Number(input.age);
              const level = input.level || 'medio';
              const minAge = level === 'fundamental' ? 15 : 18;
              const eligible = age >= minAge;
              return {
                eligible,
                level,
                age,
                minimumAge: minAge,
                message: eligible
                  ? `Candidato elegível para concluir o ${level === 'fundamental' ? 'Ensino Fundamental' : 'Ensino Médio'} no Supletivo Brasil.`
                  : `Idade mínima legal é de ${minAge} anos completos.`,
                enrollmentUrl: 'https://app.supletivo.net.br/matricula'
              };
            }
          },
          {
            name: 'get_course_info',
            description: 'Retorna informações oficiais sobre a metodologia 100% online, duração média (30-90 dias), autorização MEC e grade do Supletivo Brasil.',
            inputSchema: {
              type: 'object',
              properties: {
                level: { type: 'string', enum: ['fundamental', 'medio', 'ambos'], default: 'medio' }
              }
            },
            annotations: { readOnlyHint: true },
            execute: async () => ({
              institution: 'Supletivo Brasil — Polo Oficial Maestri Group',
              modality: 'EJA 100% Online / Acelerada',
              mecAccreditation: 'Válido em todo território nacional, emitido por escolas credenciadas pelos Conselhos Estaduais e Sistec/MEC.',
              averageDuration: '30 a 90 dias dependendo do ritmo individual.',
              enrollmentUrl: 'https://app.supletivo.net.br/matricula'
            })
          },
          {
            name: 'calculate_tuition',
            description: 'Consulta valores promocionais vigentes, parcelamento no cartão em até 12x de R$ 99 e desconto no Pix à vista.',
            inputSchema: {
              type: 'object',
              properties: {
                level: { type: 'string', enum: ['fundamental', 'medio', 'ambos'], default: 'medio' }
              }
            },
            annotations: { readOnlyHint: true },
            execute: async () => ({
              currency: 'BRL',
              promotionalPrice: 997.00,
              installmentPlan: { installments: 12, monthlyValue: 99.00 },
              cashPaymentPix: { discountedValue: 897.00, discount: '10% OFF' },
              guarantee: 'Garantia incondicional de 7 dias (CDC art. 49).',
              checkoutUrl: 'https://app.supletivo.net.br/matricula'
            })
          },
          {
            name: 'search_faq',
            description: 'Pesquisa dúvidas frequentes sobre validade do diploma, provas online e prazos de conclusão.',
            inputSchema: {
              type: 'object',
              properties: {
                query: { type: 'string', description: 'Termo de pesquisa' }
              },
              required: ['query']
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => {
              const q = (input?.query || '').toLowerCase();
              return {
                query: input?.query || '',
                results: [
                  { question: 'O diploma é válido pelo MEC?', answer: 'Sim, publicado em Diário Oficial e válido para faculdades, concursos e empregos.' },
                  { question: 'Em quanto tempo concluo?', answer: 'Em média de 30 a 90 dias conforme seu ritmo de estudo.' }
                ]
              };
            }
          },
          {
            name: 'get_enrollment_link',
            description: 'Gera link de matrícula com preservação de código de indicação do promotor.',
            inputSchema: {
              type: 'object',
              properties: {
                promoter_code: { type: 'string', description: 'Código do promotor' },
                level: { type: 'string', enum: ['fundamental', 'medio'], default: 'medio' }
              }
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => {
              const p = new URLSearchParams();
              if (input?.promoter_code) p.set('ref', input.promoter_code);
              if (input?.level) p.set('curso', input.level);
              const q = p.toString();
              return {
                url: q ? `https://app.supletivo.net.br/matricula?${q}` : 'https://app.supletivo.net.br/matricula'
              };
            }
          }
        ];

        for (const tool of tools) {
          try {
            navigator.modelContext.registerTool(tool, { signal });
          } catch (e) {
            console.warn('[WebMCP] registration error:', e);
          }
        }

        window.addEventListener('pagehide', () => controller.abort(), { once: true });
      })();
    </script>
    <script>
      import '../scripts/main.ts';
      import '../scripts/webmcp.ts';
    </script>
  </body>
</html>
