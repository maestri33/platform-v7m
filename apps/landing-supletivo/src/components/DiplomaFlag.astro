---
/**
 * Bandeira do Brasil padronizada via Design System @v7m/ui.
 * 100% SVG + CSS, sem JS na thread principal.
 */
import { BrazilFlag } from '@v7m/ui';

interface Props {
  className?: string;
  name?: string;
}
const { className = '', name } = Astro.props;
---

<div class={`diploma-wrap ${className}`} aria-hidden="true">
  <BrazilFlag name={name} />
</div>
