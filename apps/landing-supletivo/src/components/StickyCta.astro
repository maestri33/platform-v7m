---
/**
 * CTA flutuante via Design System @v7m/ui.
 * Mobile floating conversion sheet com micro-interações, glassmorphism e sincronização de padding.
 */
import { StickyCta as V7mStickyCta } from '@v7m/ui';
import { APP_URL, CTA_LABEL } from '../config';
import { cardLineShort } from '../data/price';
---

<V7mStickyCta
  brand="supletivo"
  title={cardLineShort}
  subtitle="garantia de 7 dias"
  ctaLabel={CTA_LABEL}
  ctaHref={APP_URL}
  ariaLabel="Quero meu diploma — começar matrícula 100% online"
  data-sticky-price
/>
