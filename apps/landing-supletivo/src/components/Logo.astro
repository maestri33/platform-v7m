---
/**
 * Logotipo: losango da bandeira estilizado com gradiente + checkmark + wordmark refinado.
 * variant="light" para fundos escuros, "dark" para fundos claros.
 */
interface Props {
  variant?: 'light' | 'dark';
  withLink?: boolean;
}
const { variant = 'light', withLink = true } = Astro.props;
const Tag = withLink ? 'a' : 'span';
---

<Tag class={`logo logo--${variant}`} {...withLink ? { href: '/', 'aria-label': 'Supletivo Brasil — página inicial' } : {}}>
  <svg class="logo-mark" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true" fill="none">
    <defs>
      <linearGradient id="logo-supletivo-gold" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#ffe600"></stop>
        <stop offset="100%" stop-color="#ffb300"></stop>
      </linearGradient>
    </defs>
    <path
      d="M24 4 44 24 24 44 4 24Z"
      stroke="url(#logo-supletivo-gold)"
      stroke-width="3.2"
      stroke-linejoin="round"></path>
    <path
      class="logo-check"
      d="M16 24.6l5.6 5.6L32 19.4"
      stroke-width="3.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="logo-word">Supletivo&nbsp;<b>Brasil</b></span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .logo-mark {
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(255, 196, 0, 0.3));
  }

  /* check se desenha na carga */
  @media (prefers-reduced-motion: no-preference) {
    .logo-check {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: logo-draw 0.55s var(--ease-out) 0.35s forwards;
    }
  }

  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .logo-word {
    font-family: var(--font-display, inherit);
    font-size: 1.18rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    white-space: nowrap;
    line-height: 1;
  }

  .logo--light .logo-word {
    color: #ffffff;
  }

  .logo--light .logo-check {
    stroke: #ffffff;
  }

  .logo--light .logo-word b {
    color: var(--yellow, #ffc400);
    text-shadow: 0 0 10px rgba(255, 196, 0, 0.3);
  }

  .logo--dark .logo-word {
    color: var(--ink);
  }

  .logo--dark .logo-check {
    stroke: var(--green);
  }

  .logo--dark .logo-word b {
    color: var(--green);
  }
</style>
