---
/**
 * Bloco de escassez HONESTA da condição de preço.
 *
 * Substitui a linha vaga "Preço promocional — pode subir a qualquer momento"
 * por um prazo real, verificável e datado. Se não houver prazo configurado
 * (`PUBLIC_PROMO_ENDS_AT`), este componente não renderiza nada — a página
 * volta a não fazer nenhuma afirmação de urgência, que é melhor do que fazer
 * uma falsa.
 *
 * Conformidade embutida (não são enfeites, são requisitos):
 *  - CONAR Súmula nº 7: anúncio com parcelamento precisa trazer preço à vista,
 *    número de parcelas, valor de cada parcela E total a prazo. Todos os
 *    quatro saem aqui, de `data/price.ts`.
 *  - CONAR Anexo B (Educação) item 3: tem que ficar explícito que o aluno se
 *    submete a exame de avaliação. A linha da prova presencial é obrigatória.
 *  - CONAR Anexo B item 1: o claim de credenciamento é "órgãos estaduais de
 *    educação", nunca "credenciada ao MEC" (quem credencia EJA é a Secretaria
 *    de Educação estadual). ATENÇÃO: a landing tem 14 ocorrências do claim
 *    errado hoje — este componente usa o correto; as outras precisam de fix.
 *
 * Acessibilidade: o contador é `aria-hidden` (número mudando a cada segundo em
 * região viva é tortura em leitor de tela). A informação real vai num
 * `.sr-only` com a data completa, que não muda.
 *
 * Sem JS: o contador não aparece e a frase com a data continua de pé.
 */
import { PROMO } from '../data/promo';
import { PRICE, brl, pixBRL, perMonthBRL } from '../data/price';

const cardTotalBRL = brl(PRICE.cardTotal);
---

{
  PROMO && (
    <aside
      class="promo"
      data-promo
      data-promo-ends={PROMO.endsAtMs}
      data-reveal
      aria-labelledby="promo-title"
    >
      {PROMO.cohortLabel && <p class="promo-cohort">{PROMO.cohortLabel}</p>}

      <p class="promo-title" id="promo-title">
        Esta condição vale até{' '}
        <time datetime={PROMO.endsAtISO} title={PROMO.endsAtFull}>
          {PROMO.endsAtLabel}
        </time>
      </p>

      {/* preenchido e revelado pelo script; sem JS fica fora do fluxo */}
      <div class="promo-clock" data-promo-clock hidden aria-hidden="true">
        <span class="promo-cell">
          <b data-promo-d>--</b>
          <small>dias</small>
        </span>
        <span class="promo-sep">:</span>
        <span class="promo-cell">
          <b data-promo-h>--</b>
          <small>horas</small>
        </span>
        <span class="promo-sep">:</span>
        <span class="promo-cell">
          <b data-promo-m>--</b>
          <small>min</small>
        </span>
      </div>

      <p class="sr-only">
        A condição promocional termina em {PROMO.endsAtFull}, horário de Brasília.
      </p>

      {(PROMO.nextPixTotal || PROMO.nextPerMonth) && (
        <p class="promo-after">
          Depois do prazo:{' '}
          {PROMO.nextPixTotal && <strong>{brl(PROMO.nextPixTotal)} no Pix</strong>}
          {PROMO.nextPixTotal && PROMO.nextPerMonth && ' ou '}
          {PROMO.nextPerMonth && (
            <strong>
              {PRICE.installments}x de {brl(PROMO.nextPerMonth)}
            </strong>
          )}
        </p>
      )}

      {/* CONAR Súmula nº 7 — os quatro elementos do parcelamento, juntos */}
      <p class="promo-legal">
        Hoje: {pixBRL} à vista no Pix, ou {PRICE.installments} parcelas de {perMonthBRL} no cartão,
        total a prazo de {cardTotalBRL}. A prova final é presencial. Certificação emitida por
        instituição parceira credenciada aos órgãos estaduais de educação, com respaldo na Lei nº
        9.394/96 (LDB).
      </p>
    </aside>
  )
}

<style>
  .promo {
    margin-top: 1.6rem;
    margin-bottom: 1.8rem;
    padding: 1rem 1.1rem 1.05rem;
    border: 1px solid rgb(255 196 0 / 0.45);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgb(255 196 0 / 0.1), rgb(255 196 0 / 0.03));
    text-align: center;
  }

  .promo-cohort {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 0.35rem;
  }

  .promo-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--paper);
  }

  .promo-title time {
    color: var(--yellow);
    white-space: nowrap;
    border-bottom: 1px dashed rgb(255 196 0 / 0.5);
  }

  .promo-clock {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .promo-cell {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.1rem;
    padding: 0.3rem 0.15rem 0.25rem;
    border-radius: 0.6rem;
    background: rgb(11 18 32 / 0.55);
  }

  .promo-cell b {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    font-weight: 800;
    color: var(--yellow);
  }

  .promo-cell small {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    margin-top: 0.15rem;
  }

  .promo-sep {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    padding-top: 0.35rem;
    color: rgb(255 196 0 / 0.5);
  }

  /* o separador pulsa só como batida de segundo, e nunca sob reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    .promo-sep {
      animation: promo-tick 1s steps(2, jump-none) infinite;
    }
  }

  @keyframes promo-tick {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.3;
    }
  }

  .promo-after {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    color: var(--paper);
  }

  .promo-after strong {
    color: var(--yellow);
    white-space: nowrap;
  }

  .promo-legal {
    margin-top: 0.7rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--muted-on-dark);
    max-width: 46ch;
    margin-inline: auto;
  }
</style>
