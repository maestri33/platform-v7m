# URL do app (destino de todos os CTAs). Sem barra final.
# Sem essa variável: dev usa http://localhost:3000, build usa https://app.supletivo.net.br
PUBLIC_APP_URL=https://app.supletivo.net.br

# Domínio canônico do site (canonical, Open Graph, sitemap.xml, robots.txt)
SITE=https://supletivo.net.br

# URL do backend, usada pela precificação dinâmica por ?ref= (dynamic-pricing.ts).
# Sem essa variável: dev usa http://localhost:8001, build usa https://api.supletivo.net.br
PUBLIC_BACKEND_URL=https://api.supletivo.net.br

# ID do Google Tag Manager (ex.: GTM-XXXXXXX). Vazio = sem container injetado
PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# JANELA PROMOCIONAL (bloco de urgência no card de preço)
#
# ATENCAO: ISTO E DECISAO COMERCIAL, NAO TECNICA. Só configure se o preço
#     REALMENTE vai subir quando a data passar. Prazo que não se cumpre é
#     publicidade enganosa (CDC art. 37 §1º) e alegação não comprovável
#     perante o CONAR (Anexo B — Educação, item 1).
#
# Sem PUBLIC_PROMO_ENDS_AT o bloco não renderiza e a página volta ao aviso
# genérico "pode subir a qualquer momento" — honesto porque não afirma data.
# Data já vencida, inválida, ou a mais de 120 dias: bloco omitido + warning.
# O site é estático, então o script do cliente também esconde o bloco se o
# prazo vencer sem rebuild.
# ---------------------------------------------------------------------------

# Fim da janela, ISO 8601 COM FUSO (não esquecer o -03:00)
# PUBLIC_PROMO_ENDS_AT=2026-09-30T23:59:59-03:00

# Preço que passa a valer depois do prazo. Precisa ser MAIOR que o atual,
# senão é descartado com warning (afirmar "vai subir" sem subir é falso).
# PUBLIC_PROMO_NEXT_PIX=1290
# PUBLIC_PROMO_NEXT_INSTALLMENT=129

# Nome de turma REAL, se houver ciclo de turma de verdade. Não inventar.
# PUBLIC_PROMO_COHORT_LABEL=Turma de outubro
