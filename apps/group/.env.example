# Variáveis de ambiente — app-staff (admin.maestri.group, painel do boss).
#
# Copie este arquivo para `.env.local` (gitignored) e preencha. O `.env.example`
# é versionado e serve de documentação; o `.env.local` NUNCA é commitado.

# ─── Backend (Django+Ninja) ────────────────────────────────────────────────
#
# URL_BACKEND é server-side only — o browser nunca vê esse valor. O Next reescreve
# /api/* e /media/* para cá (mata CORS e mixed-content). Em dev local costuma ser
# o IP da LXC (ex.: http://10.1.20.30); em prod é o domínio público do backend.
URL_BACKEND=http://10.1.20.30

# NEXT_PUBLIC_API_BASE_URL é exposto ao bundle do browser. Vazio = same-origin:
# o browser chama /api/* no próprio Next, que reescreve para URL_BACKEND.
# Na dúvida, deixa vazio.
NEXT_PUBLIC_API_BASE_URL=

# ─── Build provenance (inlined em /healthz) ────────────────────────────────
#
# Exportados pelo CI antes do `npm run build`. Para dev local pode deixar em
# branco — o default é "unknown".
GIT_SHA=
BUILD_AT=
