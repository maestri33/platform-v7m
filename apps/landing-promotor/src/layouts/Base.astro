---
/**
 * Layout base: SEO head completo, fontes, JSON-LD e scripts globais.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { APP_URL, BRAND, PROGRAM, GTM_ID } from '../config';

const appOrigin = new URL(APP_URL).origin;

interface Props {
  title: string;
  description: string;
  /** JSON-LD (objeto único ou @graph) — opcional */
  schema?: Record<string, unknown>;
  /** páginas fora do índice (ex.: legais até o CNPJ real) */
  noindex?: boolean;
  /** OG própria da página (path em /public); default: og-image.png */
  ogImage?: string;
}

const {
  title,
  description,
  schema,
  noindex = false,
  ogImage: ogImagePath = '/og-image.png',
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(ogImagePath, site);
const siteName = `${BRAND} · ${PROGRAM}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#141416" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- destino do CTA: handshake antecipado = app abre mais rápido no clique -->
    <link rel="preconnect" href={appOrigin} crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Seja promotor V7M — ajude alguém a concluir os estudos e ganhe por indicação, no seu Pix toda semana." />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <!-- Fontes críticas (display do hero + corpo) -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Estado "tem JS": animações de reveal só escondem conteúdo sob html.js -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {GTM_ID && (
      <script is:inline define:vars={{ GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',GTM_ID);
      </script>
    )}
  </head>
  <body>
    {GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <!-- WebMCP: Expose structured tools to AI agents via navigator.modelContext -->
    <script is:inline type="module">
      (function() {
        if (typeof window === 'undefined' || typeof navigator === 'undefined') return;
        if (!('modelContext' in navigator) || !navigator.modelContext || typeof navigator.modelContext.registerTool !== 'function') return;
        if (window.__webmcp_initialized) return;
        window.__webmcp_initialized = true;

        const controller = new AbortController();
        const signal = controller.signal;

        const tools = [
          {
            name: 'simulate_promoter_earnings',
            description: 'Simula remuneração semanal e projeção mensal do Promotor V7M (R$ 100 por matrícula paga + bônus de R$ 500 a cada 5 pagas na semana).',
            inputSchema: {
              type: 'object',
              properties: {
                paid_enrollments_per_week: { type: 'integer', minimum: 1, maximum: 100, default: 5, description: 'Número de matrículas estimadas por semana' }
              },
              required: ['paid_enrollments_per_week']
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => {
              const paid = Math.max(1, Math.floor(Number(input.paid_enrollments_per_week) || 1));
              const direct = paid * 100;
              const bonus = Math.floor(paid / 5) * 500;
              const weeklyTotal = direct + bonus;
              return {
                paid_enrollments_per_week: paid,
                currency: 'BRL',
                directCommission: direct,
                bonusAwarded: bonus,
                weeklyTotal,
                monthlyProjection: weeklyTotal * 4,
                payoutSchedule: 'Pagamento semanal automático via Pix toda sexta-feira às 18h.',
                ctaUrl: 'https://app.maestri.group'
              };
            }
          },
          {
            name: 'get_promoter_program_info',
            description: 'Retorna regras oficiais do Programa de Promotores V7M / Maestri Group: comissões, bônus, recebimento via Pix semanal e ferramentas.',
            inputSchema: {
              type: 'object',
              properties: {
                topic: { type: 'string', enum: ['general', 'commissions', 'payouts', 'rules'], default: 'general' }
              }
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => ({
              programName: 'Programa de Promotores Oficiais V7M',
              organizer: 'Maestri Group',
              topic: input?.topic || 'general',
              directCommission: 'R$ 100,00 por matrícula confirmada e paga',
              bonusRule: 'Bônus adicional de R$ 500,00 a cada 5 matrículas pagas na semana',
              payoutMethod: 'Pix semanal toda sexta às 18h',
              requirements: ['Maior de 18 anos', 'Chave Pix no nome do titular', 'Celular ou computador'],
              registrationUrl: 'https://app.maestri.group'
            })
          },
          {
            name: 'get_promoter_registration_link',
            description: 'Gera link oficial de cadastro imediato para novos promotores com amarração ao polo regional.',
            inputSchema: {
              type: 'object',
              properties: {
                hub: { type: 'string', description: 'Identificador do polo parceiro (opcional)' }
              }
            },
            annotations: { readOnlyHint: true },
            execute: async (input) => {
              const hub = input?.hub ? encodeURIComponent(input.hub.trim()) : null;
              return {
                url: hub ? `https://app.maestri.group?ref=${hub}` : 'https://app.maestri.group',
                hub: input?.hub || 'default_polo',
                instructions: 'Cadastre seus dados e chave Pix para receber seu link de promotor em menos de 2 minutos.'
              };
            }
          }
        ];

        for (const tool of tools) {
          try {
            navigator.modelContext.registerTool(tool, { signal });
          } catch (e) {
            console.warn('[WebMCP] registration error:', e);
          }
        }

        window.addEventListener('pagehide', () => controller.abort(), { once: true });
      })();
    </script>
    <script>
      import '../scripts/main.ts';
      import '../scripts/webmcp.ts';
    </script>
  </body>
</html>
