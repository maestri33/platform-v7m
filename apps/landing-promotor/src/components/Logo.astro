---
/**
 * Logotipo: losango da bandeira estilizado com gradiente ouro + wordmark + badge glass sutil.
 * variant="light" para fundos escuros, "dark" para fundos claros.
 */
import { BRAND, PROGRAM } from '../config';

interface Props {
  variant?: 'light' | 'dark';
  withLink?: boolean;
}
const { variant = 'light', withLink = true } = Astro.props;
const Tag = withLink ? 'a' : 'span';
const chars = [...BRAND];
---

<Tag class={`logo logo--${variant}`} {...withLink ? { href: '/', 'aria-label': `${BRAND} ${PROGRAM} — página inicial` } : {}}>
  <svg class="logo-mark" viewBox="0 0 48 48" width="30" height="30" aria-hidden="true" fill="none">
    <defs>
      <linearGradient id="logo-gold-mark" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#f4dca0"></stop>
        <stop offset="50%" stop-color="#d9b15a"></stop>
        <stop offset="100%" stop-color="#a87b2e"></stop>
      </linearGradient>
    </defs>
    <path
      d="M24 4 44 24 24 44 4 24Z"
      stroke="url(#logo-gold-mark)"
      stroke-width="3.2"
      stroke-linejoin="round"></path>
    <path
      class="logo-plus"
      d="M24 15v18M15 24h18"
      stroke-width="3.5"
      stroke-linecap="round"></path>
  </svg>
  <span class="logo-word">{chars.map((c) => (/\d/.test(c) ? <b>{c}</b> : c))}</span>
  <span class="logo-tag">{PROGRAM}</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo-mark {
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(217, 177, 90, 0.25));
  }

  /* sinal de mais (somar/ganhar) se desenha na carga */
  @media (prefers-reduced-motion: no-preference) {
    .logo-plus {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      animation: logo-draw 0.6s var(--ease-out) 0.35s forwards;
    }
  }

  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .logo-word {
    font-family: var(--font-display, inherit);
    font-size: 1.18rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .logo-tag {
    font-family: var(--font-body, inherit);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 9999px;
    background: rgba(217, 177, 90, 0.12);
    color: #f4dca0;
    border: 1px solid rgba(217, 177, 90, 0.32);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 0 10px rgba(217, 177, 90, 0.1);
    align-self: center;
    line-height: 1;
  }

  .logo--light .logo-word {
    color: #ffffff;
  }

  .logo--light .logo-plus {
    stroke: #ffffff;
  }

  .logo--light .logo-word b {
    color: #f4dca0;
    text-shadow: 0 0 10px rgba(217, 177, 90, 0.35);
  }

  .logo--dark .logo-word {
    color: var(--ink);
  }

  .logo--dark .logo-plus {
    stroke: var(--green);
  }

  .logo--dark .logo-word b {
    color: var(--green);
  }
</style>
