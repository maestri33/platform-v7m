---
/**
 * Faixa de texto em loop infinito via Design System @v7m/ui.
 * Zero-JS, CSS puro acelerado por GPU com acessibilidade completa.
 */
import { Marquee as V7mMarquee, type MarqueeVariant } from '@v7m/ui';

interface Props {
  items: string[];
  variant?: MarqueeVariant;
  /** segundos por loop */
  speed?: number;
  /** graus de rotação da faixa */
  tilt?: number;
}
const { items, variant = 'yellow', speed = 28, tilt = 0 } = Astro.props;
---

<V7mMarquee items={items} variant={variant} speed={speed} tilt={tilt} />

