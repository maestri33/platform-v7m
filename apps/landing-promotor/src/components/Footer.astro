---
/**
 * Rodapé Institucional e Legal via Design System @v7m/ui
 */
import { UnifiedFooter } from '@v7m/ui';
import {
  CLOSING_LABEL,
  LEGAL_NAME,
  CNPJ,
  CONTACT_EMAIL,
  CONTACT_WHATSAPP,
} from '../config';
---

<UnifiedFooter
  brand="promotor"
  context="landing"
  legalName={LEGAL_NAME}
  cnpj={CNPJ}
  contactEmail={CONTACT_EMAIL}
  contactWhatsApp={CONTACT_WHATSAPP}
  closingLabel={CLOSING_LABEL}
/>
