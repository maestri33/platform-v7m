---
/**
 * CTA flutuante via Design System @v7m/ui.
 * Mobile floating conversion sheet com micro-interações, glassmorphism e sincronização de padding.
 */
import { StickyCta as V7mStickyCta } from '@v7m/ui';
import { APP_URL, CTA_LABEL, brl, COMMISSION_DIRECT } from '../config';
const valor = brl(COMMISSION_DIRECT);
---

<V7mStickyCta
  brand="promotor"
  title={`${valor} / indicação`}
  subtitle="no Pix toda semana · 100% grátis"
  ctaLabel={CTA_LABEL}
  ctaHref={APP_URL}
  ariaLabel="Quero ser promotor — começar o cadastro gratuito"
/>
