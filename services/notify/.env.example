DATABASE_URL=postgres://notify:notify@localhost:5432/notify_server
SECRET_KEY=change-me-to-a-random-string
DEBUG=1
ALLOWED_HOSTS=*
EXTERNAL_URL=http://10.1.30.114
# Base que o Evolution usa para BUSCAR a mídia. Desde a migração da Evolution GO
# para a mesma LXC do v2 (10.1.20.200), notify e Evolution estão na MESMA rede
# 10.1.x — não há mais relay Tailscale no meio.
MEDIA_LAN_BASE=http://10.1.30.114
MEDIA_ROOT=/opt/notify-server/media
MEDIA_URL=/media/

OMNIROUTER_URL=http://10.0.1.35
OMNIROUTER_API_KEY=
# Catálogo de roteamento automático OmniRoute v3.8.50 (auto/*)
AI_MODEL=auto/best-fast
AI_ADAPT_MODEL=auto/best-fast
AI_CHAT_MODEL=auto/best-chat
AI_CODING_MODEL=auto/best-coding
AI_REASONING_MODEL=auto/best-reasoning
AI_TIMEOUT_S=90
# Adaptação por canal no pipeline (IA-first, fail-open): OmniRouter fora =
# envia o original. Desligável globalmente aqui ou por conta no painel.
AI_ADAPT_ENABLED=1
AI_ADAPT_TIMEOUT_S=30
# Cadeia de TTS (ordem de tentativa). MiniMax tem voz PT-BR de verdade; o
# Deepgram entra só para não deixar o canal mudo quando o crédito acaba.
TTS_CHAIN=minimax/speech-2.8-hd|Portuguese_SereneWoman|Portuguese_GentleTeacher,deepgram/aura-2-thalia-en|aura-2-thalia-en|aura-2-apollo-en

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Evolution GO é o único provedor. WHATSAPP_DRIVER só vale para chamadas SEM
# row WhatsAppNumber (legado); com row, quem decide é o campo `driver` dela.
WHATSAPP_DRIVER=evolution-go
# Trava de emergência: força este provedor em TODAS as contas, ignorando as rows.
# Use só durante incidente de provedor e esvazie depois.
WHATSAPP_FORCE_DRIVER=

# Retry/backoff da cascata: tentativas por provedor antes do fallback (sessão
# fora é transitória; erro de negócio nunca é retentado).
WHATSAPP_RETRY_ATTEMPTS=2
WHATSAPP_RETRY_BACKOFF_S=0.4

# Evolution GO (único provedor)
EVOLUTION_GO_BASE_URL=http://10.1.20.200:4000
# Token da instância DEFAULT (envio). Cada WhatsAppNumber guarda o seu no DB.
EVOLUTION_GO_API_KEY=
# Key GLOBAL da GO — só administração (listar/criar instância). NÃO serve para
# enviar: com várias instâncias, a key global resolve para uma arbitrária.
EVOLUTION_GO_ADMIN_KEY=

# ── Stalwart Mail Server (API JMAP & SMTP) ─────────────────────────────────
STALWART_BASE_URL=http://10.0.1.20:8080
STALWART_ADMIN_USER=ceo@v7m.org
STALWART_ADMIN_PASSWORD=
STALWART_VERIFY_TLS=0
STALWART_SMTP_HOST=10.0.1.20
STALWART_SMTP_PORT=587

# Aliases legados (opcional)
MAILCOW_BASE_URL=http://10.0.1.20:8080
MAILCOW_SMTP_HOST=10.0.1.20
MAILCOW_SMTP_PORT=587

# Conta usada quando o envio não traz account_id (serviço sem key, VPN-only).
NOTIFY_DEFAULT_ACCOUNT_SLUG=default
NOTIFY_DEFAULT_ACCOUNT_NAME=Notify

# ── Watchdog / alertas / canário ────────────────────────────────────────────
# Alertas de queda/retorno vão DIRETO pro admin (fora do pipeline).
ADMIN_ALERT_PHONE=
ADMIN_ALERT_EMAIL=
WATCHDOG_INTERVAL_MIN=1
WATCHDOG_HEAL_COOLDOWN_MIN=10
WATCHDOG_QUEUE_ALERT=50
# Canário: envio REAL diário pro destino de controle validando a cadeia toda.
CANARY_ENABLED=1
CANARY_PHONE=
CANARY_EMAIL=
CANARY_HOUR=8

# ── Hardening ───────────────────────────────────────────────────────────────
# Rate limit dos endpoints de envio (por processo; 0 = desligado).
RATE_LIMIT_PER_MIN_ACCOUNT=120
RATE_LIMIT_PER_MIN_GLOBAL=600
# Circuit breaker por provedor de WhatsApp.
BREAKER_FAIL_THRESHOLD=5
BREAKER_COOLDOWN_S=60
# Cadência anti-bloqueio por conta (K3/L3; 0 = desligada) + jitter WA.
WA_RATE_PER_MIN_ACCOUNT=30
MAIL_RATE_PER_MIN_ACCOUNT=60
WA_JITTER_MAX_S=1.5
# Produção: derruba o boot se env crítica faltar (mensagem clara).
NOTIFY_REQUIRE_ENV=0
# Logs em JSON (uma linha por evento, com request_id/external_id).
LOG_JSON=0
# Retenção de dados pessoais em dias (expurgo semanal — LGPD).
NOTIFY_RETENTION_DAYS=90

TEST_MODE=0
FERNET_KEY=change-me-generate-with-python-cryptography
